{
  "name": "karate-mcp-server",
  "version": "1.0.0",
  "description": "Model Context Protocol server providing AI agents with comprehensive knowledge of Karate DSL framework",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "karate-mcp-server": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc && node -e \"try { require('fs').chmodSync('dist/index.js', 0o755); } catch (e) {}\"",
    "dev": "tsc --watch",
    "prepare": "npm run build"
  },
  "keywords": [
    "mcp",
    "karate",
    "dsl",
    "api-testing",
    "test-automation",
    "model-context-protocol"
  ],
  "author": "vspaswin",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}